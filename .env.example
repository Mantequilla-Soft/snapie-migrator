# Copy to .env and fill in. Never commit .env.

# --- Web ---
PORT=3020
HOST=127.0.0.1                       # loopback: only nginx reaches it
PUBLIC_BASE_URL=https://migrator.example.tld
SESSION_SECRET=                      # at least 32 random characters
# Hive accounts that may act (comma-separated). Everyone else gets a read-only page.
ALLOWED_USERS=meno,coolmole
# Phase 2: lets the hotnode on this same machine call the API (loopback only). Optional.
# MIGRATOR_SERVICE_TOKEN=
# SERVICE_PORT=3021                  # service API, bound to 127.0.0.1 only; never proxy it

# --- Mongo (same database the player reads) ---
MONGODB_URI=
MONGODB_DATABASE=threespeak
MONGODB_COLLECTION_LEGACY=videos
MONGODB_COLLECTION_NEW=embed-video

# --- Buttercloud S3 ---
S3_ENDPOINT=                         # the Buttercloud gateway, https://...
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=                           # MUST equal the player's S3_BUCKET
S3_CDN_HOST=buttercloud.b-cdn.net    # MUST equal the player's S3_CDN_HOST
S3_DIRECT_HOST=s3.3speak.tv

# --- Sources (CAR exports, tried in order; hotnode direct, never the Bunny zone) ---
HOTNODE_GATEWAY=https://hotipfs-1.3speak.tv
IPFS_GATEWAYS=https://ipfs.3speak.tv,https://ipfs-audio.3speak.tv

# --- Checks ---
# PLAYER_BASE_URL=https://play.3speak.tv   # optional: confirm the player now serves S3
HIVE_API_NODES=https://api.hive.blog,https://api.deathwing.me,https://anyx.io

# --- Disk and pace ---
WORK_DIR=./work
DATA_DIR=./data
DISK_BUDGET_GB=20
DISK_RESERVE_GB=5
MAX_CONCURRENT=1                     # hard limit 2
# DOWNLOAD_RATE_LIMIT_MBPS=
