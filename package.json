{
  "name": "snapie-migrator",
  "version": "0.1.0",
  "private": true,
  "description": "Internal tool: copy a channel's 3Speak videos from IPFS to the Buttercloud S3 bucket and point the player at them.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "smoke:s3": "node scripts/s3-smoke.js",
    "check:car": "node scripts/car-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@ipld/car": "^5.4.7",
    "better-sqlite3": "^13.1.1",
    "dotenv": "^18.0.10",
    "ipfs-unixfs-exporter": "^16.2.3",
    "mongodb": "^7.8.0",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "blockstore-core": "^7.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "ipfs-unixfs-importer": "^17.1.1",
    "mongodb-memory-server": "^11.3.0",
    "vitest": "^5.1.0"
  }
}
